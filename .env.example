# ─────────────────────────────────────────────────────────────────────────────
# Kuyash Integrated Farm — frontend environment
#
# Copy to `.env.local` for development. Values are read at BUILD time: Next.js
# inlines every NEXT_PUBLIC_* variable into the bundle, so changing one in a
# running container has no effect — you must rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Django API, including the version prefix and no trailing slash.
# Required in production: the build fails loudly rather than silently defaulting
# to localhost and breaking in front of a customer.
#   local   http://localhost:8000/api/v1
#   prod    https://api.kuyashfarm.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Nothing secret belongs in this file.
#
# NEXT_PUBLIC_* variables are shipped to every visitor's browser. Never put a
# Supabase service-role key, a database URL, a Paystack SECRET key or an SMTP
# credential here — they belong in the backend's own .env. The Paystack public
# key is not needed either: the browser is redirected to Paystack's hosted
# checkout and never initialises the SDK itself.
# ─────────────────────────────────────────────────────────────────────────────
