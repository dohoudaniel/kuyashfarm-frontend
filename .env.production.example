# ═════════════════════════════════════════════════════════════════════════════
# Kuyash Farms — frontend, production
#
# A checklist, not a file to deploy. On Vercel these go in the project's
# Environment Variables; nothing here should ever be committed with real values.
#
# **Every one of these is read at BUILD time and inlined into the JavaScript
# every visitor downloads.** Two consequences that catch people out:
#
#   1. Changing one in the dashboard does nothing until you rebuild. Not
#      restart — rebuild. A "fixed" variable with a stale deployment behaves
#      exactly like a variable you never changed.
#   2. Nothing secret can ever go here. See the note at the bottom; it is not
#      a style preference, it is the difference between a public value and a
#      leaked credential.
#
# There are only three, and two of them are required.
# ═════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Django API: version prefix included, no trailing slash.
#
# **The browser resolves this, not the build server** — it must name a host your
# customers' browsers can reach over the public internet. An internal hostname
# that resolves inside your platform's network will build cleanly and fail for
# every visitor.
#
# There is deliberately no production fallback: a production build without this
# throws rather than quietly defaulting to localhost and breaking in front of a
# customer. `0.0.0.0` is refused by name — it is a bind address, not somewhere a
# client can connect to.
#
# It also has to be same-site with the frontend for sessions to survive a page
# reload. SameSite compares registrable domains, so api.kuyashfarms.com and
# kuyashfarms.com are same-site and the refresh cookie is sent; a different
# domain needs SameSite=None + Secure on the API side.
NEXT_PUBLIC_API_URL=https://api.kuyashfarms.com/api/v1

# The site's own public URL, used to build absolute metadata URLs.
#
# Open Graph and Twitter images MUST be absolute: WhatsApp, Facebook and Twitter
# fetch them from their own servers and have no idea what your origin is. Wrong
# or missing, this fails silently and only off-site — the page renders perfectly
# and the share card simply does not appear. In a market where links spread on
# WhatsApp that is a real cost, and nothing in the build will warn you.
NEXT_PUBLIC_SITE_URL=https://kuyashfarms.com


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────

# Google sign-in. Public by design: it appears in the redirect URL every visitor
# is sent to, so inlining it is correct here in a way it never would be for a
# secret. The client *secret* lives only in the backend's environment.
#
# Left empty, the Google button renders nothing at all — which is the right
# behaviour for a deployment with no Google project, and better than a button
# that fails when pressed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# MUST NOT BE SET IN PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────

# NEXT_PRERENDER_OFFLINE — a CI-only escape hatch.
#
# `/categories` and the academy pages prerender against the API, so a build with
# no backend reachable fails with ECONNREFUSED. CI has no backend and sets this
# so those pages render empty instead. In production an unreachable API should
# *stop the release*; setting this would ship a shop with no products in it and
# no error anywhere to say why.
# NEXT_PRERENDER_OFFLINE=


# ─────────────────────────────────────────────────────────────────────────────
# Nothing secret belongs in this file.
#
# NEXT_PUBLIC_* is shipped to every visitor's browser regardless of which
# component reads it or who that component renders for. No Supabase
# service-role key, no database URL, no Paystack secret key, no Brevo API key,
# no SMTP password — those belong in the backend's environment, which the
# browser never sees.
#
# `npm run check:bundle` fails the build on secret-shaped values in the client
# bundle. It exists because `NEXT_PUBLIC_ADMIN_URL` once shipped the back-office
# path to every anonymous visitor; that path now comes from `/auth/me/` and is
# null for anyone who is not back-office.
# ─────────────────────────────────────────────────────────────────────────────
